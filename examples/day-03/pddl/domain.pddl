; Four-action typed STRIPS teaching domain.
; Continuous geometry and physical execution are checked separately.
(define (domain day3-door-cup)
  (:requirements :strips :typing)
  (:types robot room door key item - object)
  (:predicates
    (at ?r - robot ?room - room)
    (item-at ?o - item ?room - room)
    (door-side ?d - door ?room - room)
    (connected ?from - room ?to - room ?d - door)
    (fits ?k - key ?d - door)
    (has-key ?r - robot ?k - key)
    (locked ?d - door)
    (unlocked ?d - door)
    (opened ?d - door)
    (handempty ?r - robot)
    (holding ?r - robot ?o - item)
    (graspable ?o - item)
    (can-unlock ?r - robot)
    (can-open ?r - robot)
    (can-move ?r - robot)
    (can-pickup ?r - robot)
  )
  (:action unlock
    :parameters (?r - robot ?d - door ?k - key ?room - room)
    :precondition (and (at ?r ?room) (door-side ?d ?room)
      (has-key ?r ?k) (fits ?k ?d) (can-unlock ?r) (locked ?d))
    :effect (and (unlocked ?d) (not (locked ?d)))
  )
  (:action open
    :parameters (?r - robot ?d - door ?room - room)
    :precondition (and (at ?r ?room) (door-side ?d ?room)
      (unlocked ?d) (can-open ?r))
    :effect (opened ?d)
  )
  (:action move
    :parameters (?r - robot ?from - room ?to - room ?d - door)
    :precondition (and (at ?r ?from) (connected ?from ?to ?d)
      (opened ?d) (can-move ?r))
    :effect (and (at ?r ?to) (not (at ?r ?from)))
  )
  (:action pickup
    :parameters (?r - robot ?o - item ?room - room)
    :precondition (and (at ?r ?room) (item-at ?o ?room)
      (graspable ?o) (handempty ?r) (can-pickup ?r))
    :effect (and (holding ?r ?o) (not (item-at ?o ?room))
      (not (handempty ?r)))
  )
)
