; Geometry is not encoded by this symbolic problem.
(define (problem day3-missing-open)
  (:domain day3-door-cup)
  (:objects r - robot a b - room d - door k - key cup - item)
  (:init
    (at r a)
    (item-at cup b)
    (door-side d a)
    (door-side d b)
    (connected a b d)
    (connected b a d)
    (fits k d)
    (has-key r k)
    (locked d)
    (handempty r)
    (graspable cup)
    (can-unlock r)
    (can-move r)
    (can-pickup r)
  )
  (:goal (holding r cup))
)
